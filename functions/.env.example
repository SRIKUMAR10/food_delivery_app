# Firebase Cloud Functions Environment Variables
# Copy this file to .env and fill in your values for local emulator development.
# For production deployment, use: firebase functions:config:set key=value

BASE_URL=https://api.yourfooddeliveryapp.com
API_KEY=your_secure_api_key_here
KEY_SECRET=your_secret_here
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
ZEGO_APP_ID=your_zego_app_id
ZEGO_SERVER_SECRET=your_zego_server_secret
