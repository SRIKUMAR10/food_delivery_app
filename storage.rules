rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isImage() {
      return request.resource.contentType != null && request.resource.contentType.matches('image/.*');
    }
    
    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    match /product_images/{sellerId}/{imageId} {
      // Only the authenticated seller can upload images to their own folder.
      // Image must be less than 5MB and must be an image type.
      allow create, update: if isAuthenticated() && 
                      request.auth.uid == sellerId &&
                      isImage() && 
                      isUnder5MB();
      allow delete: if isAuthenticated() && request.auth.uid == sellerId;
      // Anyone can read product images
      allow read: if true;
    }

    match /profile_images/{userId}/{imageId} {
      allow create, update: if isAuthenticated() && 
                      request.auth.uid == userId &&
                      isImage() && 
                      isUnder5MB();
      allow delete: if isAuthenticated() && request.auth.uid == userId;
      allow read: if true;
    }

    match /user/image/{filename} {
      allow create, update: if isAuthenticated() && 
                      isImage() && 
                      isUnder5MB();
      allow delete: if isAuthenticated();
      allow read: if true;
    }

    match /chat_attachments/{conversationId}/{filename} {
      // For chat attachments, any authenticated user can upload. 
      // Ideal security would check if the user is part of the conversation via firestore, 
      // but since storage rules can't easily cross-check complex firestore documents without custom claims,
      // we restrict to authenticated users only.
      allow write: if isAuthenticated();
      allow read: if true;
    }
  }
}
