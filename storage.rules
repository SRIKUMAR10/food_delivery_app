rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isImage() {
      return request.resource.contentType != null && request.resource.contentType.matches('image/.*');
    }
    
    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // ── Seller Product Images ─────────────────────────────────────────────
    // Isolated per seller UID: only the owning seller can upload, update, or delete.
    match /product_images/{sellerId}/{imageId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && 
                            request.auth.uid == sellerId &&
                            isImage() && 
                            isUnder5MB();
      allow delete: if isAuthenticated() && request.auth.uid == sellerId;
    }

    // ── Seller Restaurant Banners & Logos ─────────────────────────────────
    match /seller_banners/{sellerId}/{imageId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && 
                            request.auth.uid == sellerId &&
                            isImage() && 
                            isUnder5MB();
      allow delete: if isAuthenticated() && request.auth.uid == sellerId;
    }

    // ── User Profile Images ───────────────────────────────────────────────
    match /profile_images/{userId}/{imageId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && 
                            request.auth.uid == userId &&
                            isImage() && 
                            isUnder5MB();
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ── Legacy User Image Uploads ─────────────────────────────────────────
    match /user/image/{filename} {
      allow read: if true;
      allow create, update: if isAuthenticated() && 
                            isImage() && 
                            isUnder5MB() &&
                            filename.matches('^' + request.auth.uid + '.*');
      allow delete: if isAuthenticated() &&
                            filename.matches('^' + request.auth.uid + '.*');
    }

    // ── Chat Media & Attachments ──────────────────────────────────────────
    match /chat_attachments/{conversationId}/{filename} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        request.resource.size < 25 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('audio/.*') ||
         request.resource.contentType.matches('video/.*') ||
         request.resource.contentType == 'application/pdf');
    }
  }
}
