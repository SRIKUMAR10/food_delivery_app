rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Users Collection ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ── Buyer User Collection ───────────────────────────────────────────
    match /buyer_user/{userId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isOwner(userId);

      match /ratings/{ratingId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /transactions/{txId} {
        allow read, write: if isAuthenticated();
      }

      match /favorites/{favId} {
        allow read, write: if isAuthenticated();
      }

      match /cart/{cartId} {
        allow read, write: if isAuthenticated();
      }

      match /orders/{orderId} {
        allow read, write: if isAuthenticated();
      }

      match /addresses/{addrId} {
        allow read, write: if isAuthenticated();
      }

      match /support_tickets/{ticketId} {
        allow read, write: if isAuthenticated();
      }

      match /feedback/{feedbackId} {
        allow read, write: if isAuthenticated();
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ── Sellers Collection ──────────────────────────────────────────────
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if isOwner(sellerId);
      allow update: if isOwner(sellerId);
      allow delete: if isOwner(sellerId);

      match /products/{productId} {
        allow read: if true;
        allow write: if isOwner(sellerId);
      }

      match /settings/{settingId} {
        allow read: if true;
        allow write: if isOwner(sellerId);
      }

      match /payouts/{payoutId} {
        allow read: if isOwner(sellerId);
        allow write: if isOwner(sellerId);
      }

      match /transactions/{txId} {
        allow read: if isOwner(sellerId);
        allow write: if isOwner(sellerId);
      }

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isOwner(sellerId);
      }
    }

    // ── Products Collection ─────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated()
        && resource.data.sellerId == request.auth.uid;
    }

    // ── Categories Collection ───────────────────────────────────────────
    match /global_categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ── Orders Collection (Cross-Role) ──────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();

      // Buyer can cancel own orders; Seller can update status; Driver can accept & update
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid
        || resource.data.sellerId == request.auth.uid
        || resource.data.deliveryPartnerId == request.auth.uid
        || resource.data.riderId == request.auth.uid
        || (resource.data.status in ['ready', 'ready_for_pickup', 'preparing'] && (resource.data.deliveryPartnerId == null || resource.data.deliveryPartnerId == ''))
      );

      allow delete: if false;

      match /live_location/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (
          resource == null
          || resource.data.driverId == request.auth.uid
          || request.resource.data.driverId == request.auth.uid
        );
      }

      match /messages/{msgId} {
        allow read: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );
        allow write: if isAuthenticated();
      }
    }

    // ── Delivery Partners Collection ────────────────────────────────────
    match /delivery_partners/{partnerId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if isOwner(partnerId);

      match /notifications/{notificationId} {
        allow read: if isOwner(partnerId);
        allow create: if true;
        allow update, delete: if isOwner(partnerId);
      }

      match /transactions/{txId} {
        allow read, write: if isAuthenticated();
      }

      match /earnings/{earningId} {
        allow read, write: if isAuthenticated();
      }

      match /sessions/{sessionId} {
        allow read, write: if isAuthenticated();
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ── Riders Collection ───────────────────────────────────────────────
    match /riders/{riderId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ── Conversations & Messages ────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ── Reviews & Ratings ───────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && resource.data.customerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.customerId == request.auth.uid;
    }

    // ── Coupons Collection (Collection Group & Root) ────────────────────
    match /{path=**}/coupons/{couponId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ── Support Tickets ─────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Default Deny ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
