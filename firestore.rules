rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSellerOwner(sellerId) {
      return isAuthenticated() && request.auth.uid == sellerId;
    }

    // ── Users Collection ─────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Buyer User Collection ────────────────────────────────────────────
    match /buyer_user/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      match /ratings/{ratingId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /transactions/{txId} {
        allow read, write: if isOwner(userId);
      }

      match /favorites/{favId} {
        allow read, write: if isOwner(userId);
      }

      match /cart/{cartId} {
        allow read, write: if isOwner(userId);
      }

      match /orders/{orderId} {
        allow read, write: if isOwner(userId);
      }

      match /addresses/{addrId} {
        allow read, write: if isOwner(userId);
      }

      match /support_tickets/{ticketId} {
        allow read, write: if isOwner(userId);
      }

      match /feedback/{feedbackId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notifId} {
        allow read, write: if isOwner(userId);
      }

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Sellers Collection ───────────────────────────────────────────────
    // Public restaurant details are readable by customers for discovery.
    // Sensitive financial/configuration subcollections are strictly isolated to the owner.
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if isSellerOwner(sellerId);
      allow update: if isSellerOwner(sellerId);
      allow delete: if isSellerOwner(sellerId);

      // Menu products under seller document
      match /products/{productId} {
        allow read: if true;
        allow write: if isSellerOwner(sellerId);
      }

      // Menu category definitions
      match /menu_categories/{categoryId} {
        allow read: if true;
        allow write: if isSellerOwner(sellerId);
      }

      // Business hours schedule
      match /business_hours/{docId} {
        allow read: if true;
        allow write: if isSellerOwner(sellerId);
      }

      // Restaurant promotions and coupons
      match /coupons/{couponId} {
        allow read: if true;
        allow write: if isSellerOwner(sellerId);
      }

      // Reviews submitted for this restaurant
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.customerId == request.auth.uid ||
          isSellerOwner(sellerId)
        );
        allow delete: if isAuthenticated() && resource.data.customerId == request.auth.uid;
      }

      // Private settings (financial, bank info, payouts)
      match /settings/{settingId} {
        allow read, write: if isSellerOwner(sellerId);
      }

      match /payouts/{payoutId} {
        allow read, write: if isSellerOwner(sellerId);
      }

      match /transactions/{txId} {
        allow read, write: if isSellerOwner(sellerId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isSellerOwner(sellerId);
      }

      match /disputes/{disputeId} {
        allow read, write: if isSellerOwner(sellerId);
      }

      match /analytics/{docId} {
        allow read, write: if isSellerOwner(sellerId);
      }

      match /{allSubcollections=**} {
        allow read, write: if isSellerOwner(sellerId);
      }
    }

    // ── Global Products Collection ───────────────────────────────────────
    // Multi-restaurant food search & ordering catalog
    match /products/{productId} {
      allow read: if true;
      // Seller can only create product with their own sellerId
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      // Seller cannot modify or overwrite another seller's products or reassign ownership
      allow update: if isAuthenticated() &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == resource.data.sellerId;
      allow delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
    }

    // ── Categories Collection ────────────────────────────────────────────
    match /global_categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ── Orders Collection (Strict Cross-Role Isolation) ──────────────────
    match /orders/{orderId} {
      // Order is only readable by the buyer, owning seller, or assigned courier
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.deliveryPartnerId == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        (
          resource.data.status in [
            'ready', 'ready_for_pickup', 'order_ready', 'searching_driver',
            'pending', 'new', 'neworder', 'confirmed', 'preparing'
          ] &&
          (resource.data.deliveryPartnerId == null || resource.data.deliveryPartnerId == '' || resource.data.riderId == null || resource.data.riderId == '')
        )
      );

      // Only authenticated buyer can create an order for themselves
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;

      // Status updates strictly partitioned by role with immutability of buyer & seller IDs
      allow update: if isAuthenticated() && (
        // Buyer can cancel or rate their own order
        (
          resource.data.customerId == request.auth.uid &&
          request.resource.data.customerId == resource.data.customerId &&
          request.resource.data.sellerId == resource.data.sellerId
        ) ||
        // Owning Seller can confirm, prepare, mark ready, or cancel
        (
          resource.data.sellerId == request.auth.uid &&
          request.resource.data.customerId == resource.data.customerId &&
          request.resource.data.sellerId == resource.data.sellerId
        ) ||
        // Courier partner can accept order, pick up, or deliver
        (
          resource.data.deliveryPartnerId == request.auth.uid ||
          resource.data.riderId == request.auth.uid ||
          resource.data.driverId == request.auth.uid ||
          (
            resource.data.status in [
              'ready', 'ready_for_pickup', 'order_ready', 'searching_driver',
              'pending', 'new', 'neworder', 'confirmed', 'preparing'
            ] &&
            (resource.data.deliveryPartnerId == null || resource.data.deliveryPartnerId == '' || resource.data.riderId == null || resource.data.riderId == '')
          )
        )
      );

      allow delete: if false;

      // Live GPS tracking subcollection
      match /live_location/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (
          resource == null ||
          resource.data.driverId == request.auth.uid ||
          request.resource.data.driverId == request.auth.uid
        );
      }

      // Order-specific messaging
      match /messages/{msgId} {
        allow read: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid
        );
        allow write: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      }

      // Atomic delivery assignment audit trail (per order)
      match /assignments/{assignmentId} {
        allow read, write: if isAuthenticated() && (
          resource == null ||
          resource.data.partnerId == request.auth.uid ||
          request.resource.data.partnerId == request.auth.uid
        );
      }
    }

    // ── Atomic Delivery Order Assignments Collection ────────────────────
    match /order_assignments/{assignmentId} {
      allow read, write: if isAuthenticated() && (
        resource == null ||
        resource.data.partnerId == request.auth.uid ||
        request.resource.data.partnerId == request.auth.uid
      );
    }

    // ── Delivery Partners Collection ─────────────────────────────────────
    match /delivery_partners/{partnerId} {
      allow read: if true;
      allow create, update: if isOwner(partnerId);
      allow delete: if isOwner(partnerId);

      match /notifications/{notificationId} {
        allow read, write: if isOwner(partnerId);
      }

      match /transactions/{txId} {
        allow read, write: if isOwner(partnerId);
      }

      match /earnings/{earningId} {
        allow read, write: if isOwner(partnerId);
      }

      match /sessions/{sessionId} {
        allow read, write: if isOwner(partnerId);
      }

      match /{allSubcollections=**} {
        allow read, write: if isOwner(partnerId);
      }
    }

    // ── Riders Collection ────────────────────────────────────────────────
    match /riders/{riderId} {
      allow read: if true;
      allow write: if isOwner(riderId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(riderId);
      }
    }

    // ── Conversations & Messages (Secure Chat) ───────────────────────────
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds) ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.deliveryPartnerId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        (request.resource.data.participantIds != null && request.auth.uid in request.resource.data.participantIds) ||
        request.resource.data.buyerId == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid ||
        request.resource.data.deliveryPartnerId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds) ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.deliveryPartnerId == request.auth.uid
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ── Reviews & Ratings ────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.customerId == request.auth.uid;
    }

    match /review_reports/{reportId} {
      allow create, read: if isAuthenticated();
      allow update, delete: if false;
    }

    // ── Coupons Collection (Collection Group & Root) ─────────────────────
    match /{path=**}/coupons/{couponId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
    }

    // ── Support Tickets ──────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      allow delete: if false;
    }

    // ── Default Deny ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
