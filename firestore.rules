rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users Collection ──────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ── Buyer User Collection ─────────────────────────────────────────────
    match /buyer_user/{userId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ── Sellers Collection ────────────────────────────────────────────────
    match /sellers/{sellerId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ── Products Collection ───────────────────────────────────────────────
    match /products/{productId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ── Categories Collection ─────────────────────────────────────────────
    match /global_categories/{categoryId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ── Orders Collection ─────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ── Order Assignments Collection ──────────────────────────────────────
    match /order_assignments/{assignmentId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ── Delivery Ratings Collection ───────────────────────────────────────
    match /delivery_ratings/{ratingId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ── Delivery Partners Collection ──────────────────────────────────────
    match /delivery_partners/{partnerId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ── Riders Collection ─────────────────────────────────────────────────
    match /riders/{riderId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ── Conversations & Messages ──────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ── Reviews & Ratings ─────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /review_reports/{reportId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ── Coupons Collection ────────────────────────────────────────────────
    match /coupons/{couponId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /{path=**}/coupons/{couponId} {
      allow read, write: if true;
    }

    // ── Support Tickets ───────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ── Default Fallback ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
